#!/usr/bin/env bash
# samsung-tv-debloat: run debloat-tv.sh on the TV over SSH.
#   samsung-tv-debloat [stop|status|start] [-n]   see debloat-tv.sh
#   samsung-tv-debloat install DIR                copy debloat-tv.sh to DIR on the TV
#                                                  (for a boot hook to run it from there)
# Settings: TV_HOST and TV_KEY from ../tv.conf or the environment.
set -euo pipefail
here=$(dirname "$(readlink -f "$0")")
top=$(dirname "$here")
[ -f "$top/tv.conf" ] && . "$top/tv.conf"
TV_HOST=${TV_HOST:?set TV_HOST in tv.conf (e.g. root@192.168.1.50)}
TV_KEY=${TV_KEY:-$HOME/.ssh/id_ed25519}
tv() { ssh -i "$TV_KEY" -o BatchMode=yes -o ConnectTimeout=8 "$TV_HOST" "$@"; }

case ${1:-} in
  -h | --help) sed -n '2,6s/^# \{0,1\}//p' "$0" ;;
  install)
    dir=${2:?usage: samsung-tv-debloat install DIR}
    tv "mkdir -p $(printf %q "$dir") && cat > $(printf %q "$dir/debloat-tv.sh")" < "$here/debloat-tv.sh"
    echo "installed $TV_HOST:$dir/debloat-tv.sh; run it at boot with:"
    echo "  bash -s -- stop --wait-boot < $dir/debloat-tv.sh > /tmp/debloat.log 2>&1 &"
    ;;
  *) tv "bash -s --$(printf ' %q' "$@")" < "$here/debloat-tv.sh" ;;
esac
