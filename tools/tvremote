def serve(port):
    # Separate sessions so that key presses never wait for a picture.
    screen, remote = Agent(), Agent()

    class H(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def send(self, code, body, ctype="text/plain"):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            u = urllib.parse.urlparse(self.path)
            if u.path == "/":
                return self.send(200, PAGE.encode(), "text/html; charset=utf-8")
            if u.path == "/frame.jpg":
                scale = urllib.parse.parse_qs(u.query).get("scale", ["2"])[0]
                try:
                    return self.send(200, screen.frame(int(scale)), "image/jpeg")
                except Exception as e:
                    return self.send(503, str(e).encode())
            if u.path == "/keys":
                return self.send(200, json.dumps(sorted(KEYS)).encode(), "application/json")
            if u.path.startswith("/key/"):
                return self.do_POST()
            self.send(404, b"not found")

        def do_POST(self):
            m = re.fullmatch(r"/key/([A-Za-z0-9]+)", urllib.parse.urlparse(self.path).path)
            if not m:
                return self.send(404, b"not found")
            try:
                remote.key(m.group(1))
                self.send(200, b"ok")
            except KeyError:
                self.send(400, b"unknown key")
            except Exception as e:
                self.send(503, str(e).encode())

    srv = http.server.ThreadingHTTPServer(("127.0.0.1", port), H)
    print(f"TV remote on http://localhost:{port}  (Ctrl-C to stop)")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


def main(argv):
    args = list(argv)
    opt = lambda name, default: (args.pop(args.index(name) + 1), args.remove(name))[0] if name in args else default
    port = int(opt("--port", 8790))
    scale = int(opt("--scale", 2))
    cmd = args.pop(0) if args else "serve"
    if cmd == "serve":
        serve(port)
    elif cmd == "shot" and args:
        data = Agent().frame(scale)
        open(args[0], "wb").write(data)
        print(f"saved {args[0]} ({len(data)} bytes)")
    elif cmd == "key" and args:
        a = Agent()
        for name in args:
            a.key(name)
            time.sleep(0.35)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
