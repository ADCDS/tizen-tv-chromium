#!/usr/bin/env python3
"""tvremote: see and drive the TV from a PC.

  tools/tvremote [serve] [--port 8790]   web page with the live screen and a remote
                                         control: http://localhost:8790
  tools/tvremote shot FILE.jpg [--scale N]   save what the TV shows
  tools/tvremote key NAME...             press remote keys (see KEYS), e.g. key home right ok

It runs tvremote's agent on the TV over one SSH session (uploaded to /tmp on
first use; build it with `make -C tvremote`). The screen is the TV's graphics
plane as the compositor mirrors it: TV pictures on the video plane (antenna,
HDMI) show as black. Settings: TV_HOST and TV_KEY from ../tv.conf.
"""
import hashlib
import http.server
import json
import os
import re
import shlex
import subprocess
import sys
import threading
import time
import urllib.parse

TOP = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
AGENT = os.path.join(TOP, "tvremote", "build", "tvremote-agent-armv7")

# Remote key -> evdev code written to the TV's remote input device (the TV's
# keymap code minus 8; Samsung's keymap puts many keys at unusual codes).
KEYS = {
    "power": None,  # deliberately not offered
    "up": 103, "down": 108, "left": 105, "right": 106, "ok": 28, "back": 1, "exit": 174,
    "home": 63, "source": 64, "menu": 396, "info": 188, "chlist": 65,
    "red": 59, "green": 60, "yellow": 61, "blue": 62,
    "volup": 68, "voldown": 67, "mute": 66, "chup": 88, "chdown": 87,
    "play": 200, "pause": 201, "stop": 166, "rew": 168, "ff": 208,
    **{str(d): (11 if d == 0 else d + 1) for d in range(10)},
}
KEYS = {k: v for k, v in KEYS.items() if v}


def conf():
    """TV_HOST and TV_KEY from tv.conf (shell syntax) or the environment."""
    vals = {}
    path = os.path.join(TOP, "tv.conf")
    if os.path.exists(path):
        out = subprocess.run(["bash", "-c", f'set -a; . {shlex.quote(path)}; echo "$TV_HOST"; echo "$TV_KEY"'],
                             capture_output=True, text=True).stdout.splitlines()
        vals = dict(zip(["TV_HOST", "TV_KEY"], out + ["", ""]))
    host = os.environ.get("TV_HOST") or vals.get("TV_HOST")
    key = os.environ.get("TV_KEY") or vals.get("TV_KEY") or os.path.expanduser("~/.ssh/id_ed25519")
    if not host:
        sys.exit("set TV_HOST in tv.conf")
    return host, os.path.expanduser(key)


class Agent:
    """The agent on the TV, over one SSH session; restarted if it dies."""

    def __init__(self):
        self.host, self.keyfile = conf()
        self.lock = threading.Lock()
        self.p = None

    def ssh(self, cmd, **kw):
        return subprocess.run(["ssh", "-i", self.keyfile, "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", self.host, cmd], **kw)

    def start(self):
        if not os.path.exists(AGENT):
            sys.exit(f"{AGENT} missing: run make -C tvremote")
        want = hashlib.sha256(open(AGENT, "rb").read()).hexdigest()
        have = self.ssh("sha256sum /tmp/tvremote-agent 2>/dev/null | cut -c1-64", capture_output=True, text=True).stdout.strip()
        if have != want:
            with open(AGENT, "rb") as f:
                self.ssh("cat > /tmp/tvremote-agent.new && chmod 755 /tmp/tvremote-agent.new && mv -f /tmp/tvremote-agent.new /tmp/tvremote-agent",
                         stdin=f, check=True)
        self.p = subprocess.Popen(["ssh", "-i", self.keyfile, "-o", "BatchMode=yes", "-o", "ServerAliveInterval=15", self.host,
                                   "XDG_RUNTIME_DIR=/run exec /tmp/tvremote-agent"],
                                  stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)

    def call(self, line):
        """Send one command; returns (header, payload or None)."""
        with self.lock:
            for attempt in (1, 2):
                if self.p is None or self.p.poll() is not None:
                    self.start()
                try:
                    self.p.stdin.write((line + "\n").encode())
                    self.p.stdin.flush()
                    head = self.p.stdout.readline().decode().strip()
                    if not head:
                        raise OSError("agent closed")
                    if head.startswith("frame "):
                        n = int(head.split()[1])
                        data = b""
                        while len(data) < n:
                            chunk = self.p.stdout.read(n - len(data))
                            if not chunk:
                                raise OSError("agent closed")
                            data += chunk
                        return head, data
                    return head, None
                except (OSError, ValueError):
                    if self.p:
                        self.p.kill()
                    self.p = None
                    if attempt == 2:
                        raise

    def frame(self, scale=2):
        head, data = self.call(f"frame {int(scale)}")
        if data is None:
            raise RuntimeError(head)
        return data

    def key(self, name):
        code = KEYS.get(name.lower())
        if code is None:
            raise KeyError(name)
        head, _ = self.call(f"key {code}")
        if head != "ok":
            raise RuntimeError(head)


