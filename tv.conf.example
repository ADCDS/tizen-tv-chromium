# Copy to tv.conf (ignored by git) and adjust. Read by kiosk/kiosk, mgl/fetch-tv-libs.sh,
# debloat/samsung-tv-debloat and tools/*.

# Root SSH access to the TV.
TV_HOST=root@192.168.1.50
TV_KEY=~/.ssh/id_ed25519

# Kiosk (all optional).
KIOSK_URL=https://example.org/  # page opened by `kiosk start` without a URL
KIOSK_LANG=en_US                # Chromium UI language and Accept-Language, e.g. pt_BR
KIOSK_TZ=UTC                    # e.g. America/Sao_Paulo
#KIOSK_GPU=0                    # force software rendering (default: GPU when mgl is installed)
#KIOSK_W=1920 KIOSK_H=1080 KIOSK_SCALE=2

# Apps the TV helper (tvkioskd) can open, one Chromium tab and one TV tile each:
#   id|Name|URL|icon|keep-or-discard
#   id: lowercase letters/digits; icon: PNG/SVG file or URL for the tile (empty: a letter);
#   discard: close the tab when leaving (e.g. camera views)
KIOSK_APPS="news|News|https://example.org/||keep;cams|Cameras|http://nvr.local:5000/||discard"
#KIOSK_SEARCH=https://www.google.com/search?q=%s   # address box searches

# Tiles (tiles/build.sh): the Tizen security profile to sign with, and the CLI.
#TIZEN_PROFILE=mytv
#TIZEN_CLI=~/tizen-studio/tools/ide/bin/tizen
